#!/usr/bin/env bash

set -euo pipefail

ROOT_DIR="${HOME}/terminalConfigs"
ENV_FILE="${ROOT_DIR}/.env"

resolve_git() {
    local user_git="/etc/profiles/per-user/${USER}/bin/git"

    if [ -x "$user_git" ]; then
        printf '%s\n' "$user_git"
        return 0
    fi

    if command -v git >/dev/null 2>&1; then
        command -v git
        return 0
    fi

    if [ -x /usr/bin/git ]; then
        printf '%s\n' /usr/bin/git
        return 0
    fi

    return 1
}

if [ ! -f "$ENV_FILE" ]; then
    echo "Missing env file: $ENV_FILE" >&2
    exit 1
fi

set -a
. "$ENV_FILE"
set +a

if [ -z "${NIX_REBUILD_SECRET_FILES:-}" ]; then
    echo "NIX_REBUILD_SECRET_FILES is not set in $ENV_FILE" >&2
    exit 1
fi

read -r -a SECRET_FILES <<< "$NIX_REBUILD_SECRET_FILES"

cleanup() {
    "$GIT_BIN" restore --staged "${SECRET_FILES[@]}" >/dev/null 2>&1 || true
}

cd "${ROOT_DIR}/.dotfiles/nix/" || exit 1
GIT_BIN="$(resolve_git)" || {
    echo "Unable to find git in /etc/profiles/per-user/${USER}/bin, PATH, or /usr/bin." >&2
    exit 1
}

trap cleanup EXIT

"$GIT_BIN" add "${SECRET_FILES[@]}"

#nix run home-manager -- "$@" switch --flake "${ROOT_DIR}/.dotfiles/nix#$(whoami)"
home-manager switch --flake "${ROOT_DIR}/.dotfiles/nix#$(whoami)"
